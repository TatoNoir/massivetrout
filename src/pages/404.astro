---
import Layout from "../layouts/Layout.astro";
---

<Layout lang="en" title="Page Not Found - Massive Trout Fly Fishing" description="Page not found" bodyClass="no-js">
  <section class="sec__hero hero--small">
    <div class="container">
      <div class="hero__content">
        <h1 class="heading--big text--center">404</h1>
      </div>
    </div>
  </section>

  <section class="sec__intro intro_sinback">
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <h2 class="heading--big text--center">Page not found</h2>
          <img class="separador" src="/imagenes/body/separador.png" alt="separador" />
          <p class="text--grey text--center">
            The page you are looking for doesn't exist or has been moved.
          </p>
          <a class="btn btn--full btn--oval" href="/" role="button" title="Home">Go back home</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
