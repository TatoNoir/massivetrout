---
import Layout from "../../layouts/Layout.astro";
import ContactForm from "../../components/ContactForm.astro";
---

<Layout lang="es" title="Contacto - Massive Trout Fly Fishing, Bariloche, Patagonia Argentina" description="Massive Trout Fly Fishing" bodyClass="no-js">
  <section class="sec__hero hero--small" id="hero_contact">
    <div class="container">
      <div class="hero__content">
        <h1 class="heading--big text--center">Envienos un mensaje</h1>
      </div>
    </div>
  </section>

  <section class="sec__contact">
    <div class="container">
      <h2 class="heading--big text--center">Contáctenos</h2>
      <h3 class="text--grey text--center">¡PARA SALUDAR O PEDIR INFORMACIÓN!</h3>
      <img class="separador" src="/images/shared/separators/separador.png" alt="separador" />
      <ContactForm lang="es" />
    </div>
  </section>
</Layout>
