---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Layout
  lang="en"
  title="Activities for Non-Anglers - Massive Trout Fly Fishing, Patagonia Argentina"
  description="Activities and experiences for non-fishing companions in Bariloche and Patagonia"
  bodyClass="no-js"
>
  <section class="sec__hero hero--small" id="hero_nonanglers">
    <div class="container">
      <div class="hero__content">
        <h1 class="heading--big text--center">Activities for Non-Anglers</h1>
      </div>
    </div>
  </section>

  <section class="sec__intro intro_sinback intro_nonanglers">
    <div class="container">
      <div class="row">
        <div class="col-md-12">
          <h2 class="heading--intro text--center">Because it’s not all about fishing</h2>
          <img class="separador" src="/images/shared/separators/separador.png" alt="separador" />
          <p class="text--grey text--center">
            At Massive Trout Fly Fishing, we believe Patagonia has much more to offer than its rivers and trout. That is why we want non-fishing companions — as well as those simply looking to discover this extraordinary part of the world in a different way — to experience MTFF from another perspective.
          </p>
          <p class="text--grey text--center">
            While our anglers are on the river, Patagonia continues to unfold through its landscapes, wildlife, cuisine and culture. From hiking through the Andes to horseback riding, boating, wine tasting or an exceptional dinner, we offer a range of carefully selected activities designed to make the most of every moment in Patagonia.
          </p>
          <p class="text--grey text--center">
            <strong>Because for us, MTFF is not only about fishing. It’s about experiencing Patagonia.</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec__activities nonanglers-activities">
    <div class="container">
      <div class="row nonanglers-grid">
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/bird-watching.jpg" alt="Bird Watching" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Bird Watching</h2>
            <p class="nonangler-card__text">Discover Patagonia’s remarkable birdlife, from native forest species to majestic birds of prey, in some of the most pristine environments around Bariloche.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/trekking.jpg" alt="Trekking" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Trekking</h2>
            <p class="nonangler-card__text">Follow scenic mountain trails through ancient forests, alpine valleys and rugged landscapes, with the Andes as your constant backdrop.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/horseback-riding.jpg" alt="Horseback Riding" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Horseback Riding</h2>
            <p class="nonangler-card__text">Ride through the Patagonian countryside, across forests, valleys and open steppe, following trails deeply connected to the region’s gaucho traditions.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/wine-tasting.jpg" alt="Wine Tasting" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Wine Tasting</h2>
            <p class="nonangler-card__text">Taste a curated selection of Argentine wines alongside regional cuisine, discovering the character and diversity of Argentina’s wine culture.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/rafting.jpg" alt="Rafting" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Rafting</h2>
            <p class="nonangler-card__text">Navigate Patagonia’s wild rivers through rapids and stretches of calm water, surrounded by forests, mountains and spectacular Andean scenery.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/river-floating.jpg" alt="River Floating" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">River Floating</h2>
            <p class="nonangler-card__text">Slow down and let the river set the pace, drifting through quiet stretches of water while observing the surrounding landscape and wildlife.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/scuba-diving.jpg" alt="Scuba Diving" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Scuba Diving</h2>
            <p class="nonangler-card__text">Dive into the remarkably clear waters of Patagonia’s lakes and discover a different side of the region beneath the surface.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/excursions.jpg" alt="Excursions" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Excursions</h2>
            <p class="nonangler-card__text">Scenic drives reveal the many faces of the region, from Circuito Chico and Circuito Grande to Villa La Angostura, with panoramic lakes, forests and mountain viewpoints along the way.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/mountain-refuge.jpg" alt="Mountain Refuge Hikes" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Mountain Refuge Hikes</h2>
            <p class="nonangler-card__text">Reach some of Bariloche’s iconic mountain refuges on foot, with trails that climb through native forests toward dramatic alpine scenery and unforgettable viewpoints.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/nahuel-huapi-tronador.jpg" alt="Nahuel Huapi National Park & Mount Tronador" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">Nahuel Huapi National Park &amp; Mount Tronador</h2>
            <p class="nonangler-card__text">Venture deep into Nahuel Huapi National Park and head toward Mount Tronador, where glaciers, waterfalls, forests and imposing peaks create one of Patagonia’s most memorable landscapes.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="nonangler-card">
            <img src="/images/non-anglers/dinner.jpg" alt="7-8 Course Dinner" class="img-responsive" loading="lazy" />
            <h2 class="nonangler-card__title">7–8 Course Dinner</h2>
            <p class="nonangler-card__text">A sophisticated culinary journey built around seasonal ingredients, Patagonian flavors and carefully selected Argentine wines. Highly recommended.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec__contact">
    <div class="container">
      <h2 class="heading--big text--center">Contact Us</h2>
      <h3 class="text--grey text--center">PLAN YOUR TRIP WHETHER YOU FISH OR NOT</h3>
      <img class="separador" src="/images/shared/separators/separador.png" alt="separador" />
      <ContactForm lang="en" />
    </div>
  </section>
</Layout>