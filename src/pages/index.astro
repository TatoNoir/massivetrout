---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Reviews from "../components/Reviews.astro";
---

<Layout lang="en" title="Fly Fishing in Patagonia - Massive Trout Fly Fishing, Bariloche, Argentina" bodyClass="no-js">
  <section class="sec__hero hero--big hero__slider">
    <div id="slides">
      <div class="slides-container">
        <div class="slide-1"></div>
        <div class="slide-2"></div>
        <div class="slide-3"></div>
      </div>
    </div>
    <div class="container slider-home">
      <div class="hero__content">
        <div class="row">
          <div class="col-md-12">
            <h2 class="heading--big">Massive Experience in Patagonia</h2>
            <p class="text--center">
              Discover the most wild and pristine waters around the world with the best Outfitters
              <br />
              MTFF offers you this incredible opportunity to discover and fish, in Patagonia Argentina
              <br />
              <span style="display: none">Patagonia Fly Fishing - Fly Fishing in Patagonia</span>
            </p>
          </div>
        </div>
        <div class="row">
          <div class="col-md-12 text--center">
            <a class="btn btn--full btn--oval" href="#intro" role="button">Begin your trip</a>
          </div>
        </div>      </div>
    </div>
  </section>

  <section class="sec__intro intro-home" id="intro">
    <div class="container">
      <div class="row intro-home-row">
        <div class="col-md-8">
          <h1 class="heading--big text--center">Fly Fishing in Patagonia</h1>
          <h3 class="heading--small text--center" id="sub_index">YOUR NEXT ADVENTURE AWAITS HERE, IN THE HEART OF PATAGONIA ARGENTINA</h3>
          <img class="separador" src="/images/shared/separators/separador.png" alt="separador" />
          <p class="text--grey">
            If you are an angler, fly fishing in Patagonia has likely been on your bucket list, and for good reason. The trout waters in Patagonia, Argentina are some of the most pristine, undisturbed waters in the world, with healthy populations of wild brown and rainbow trout! Our custom trips take anglers through a breathtaking mosaic of landscapes from vast steppes to majestic mountain peaks and ancient volcanoes.
          </p>
          <p class="text--grey">
            The guides at Massive Trout Fly Fishing are experienced anglers who are passionate about sharing their knowledge and expertise with all levels of anglers. We truly love the opportunity to create an unforgettable, unique fly fishing experience for our clients!
          </p>
          <div class="text--center intro-home-cta">
            <a class="btn btn--full btn--oval" href="/booking/" role="button" title="Book your trip">Book your trip</a>
          </div>
        </div>
        <div class="col-md-4 intro-home-video">
          <div class="video-embed">
            <video
              src="/images/home/brown_trout_release.mp4"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            ></video>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec__activities home-programs-preview">
    <div class="container">
      <div class="row">
        <div class="col-md-4">
          <a href="/programs/#daily_trip" class="card--info-home">
            <img src="/images/home/programs/home_programs_01.jpg" alt="Fishing Drift" class="img-responsive" loading="lazy" />
            <div class="card-title-home" >
              <img class="card-icon-home" src="/images/home/icons/daytrip_dorado.svg" alt="Daily programs icon" loading="lazy" />
              <h2 class="card-heading-home">Daily Programs</h2>
              </div>
            <p class="text--grey text--center">Fish in the best environments of Nahuel Huapi National Park and Lanin National Park</p>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/programs/#overnight_trip" class="card--info-home">
            <img src="/images/home/programs/home_programs_02.jpg" alt="Fisherman with Trout" class="img-responsive" loading="lazy" />
            <div class="card-title-home">
              <img class="card-icon-home" src="/images/home/icons/lodges_dorado.svg" alt="Camping spot icon" loading="lazy" />
              <h2 class="card-heading-home">Overnight Programs</h2>
            </div>
            <p class="text--grey text--center">Float &amp; Camp covering large distances of water, fishing in the wildest part of North Patagonia.</p>
          </a>
        </div>
        <div class="col-md-4">
          <a href="/programs/#allinclusive_trip" class="card--info-home">
            <img src="/images/home/programs/home_programs_03.jpg" alt="Patagonian Lodge" class="img-responsive" loading="lazy" />
            <div class="card-title-home">
              <img class="card-icon-home" src="/images/home/icons/overnigt_dorado.svg" alt="Overnight programs icon" loading="lazy" />
              <h2 class="card-heading-home">All Inclusive Programs</h2>
            </div>
            <p class="text--grey text--center">MTFF is in charge of everything you can customize your all inclusive program.</p>
          </a>
        </div>
      </div>

      <div class="programs-divider"></div>

      <div class="row programs-row-lg">
        <div class="col-md-6">
          <a href="/programs/#dorado_trip" class="card--info-home-lg">
            <img class="badge-new" src="/images/home/icons/badge-new.svg" alt="New" />
            <div class="card-location-lg">
              <span class="card-location-flag">🇦🇷</span> Corrientes
            </div>
            <img src="/images/home/programs/card-programs-dorado.jpeg" alt="Dorado Fly Fishing" class="img-responsive" loading="lazy" />
            <h3 class="card-heading-home-lg"><img class="card-heading-icon-lg" src="/images/programs/icons/fishing_rod.svg" alt="" /> Dorado Fly Fishing</h3>
          </a>
        </div>
        <div class="col-md-6">
          <a href="/programs/usa/#daily_trip_wyoming" class="card--info-home-lg">
            <img class="badge-new" src="/images/home/icons/badge-new.svg" alt="New" />
            <div class="card-location-lg">
              <span class="card-location-flag">🇺🇸</span> Casper - USA
            </div>
            <img src="/images/home/programs/card-programs-wyoming.jpeg" alt="Wyoming - North Platte River" class="img-responsive" loading="lazy" />
            <h3 class="card-heading-home-lg"><img class="card-heading-icon-lg" src="/images/shared/icons/buffalo.svg" alt="" /> Wyoming - North Platte River</h3>
          </a>
          <p class="card-powered-home">Powered by <a href="https://wyocowboydrifters.com/" target="_blank" rel="noopener noreferrer">Cowboy Drifters</a></p>
        </div>
        </div>
      </div>

      <a class="btn btn--full btn--oval" href="/booking/" role="button" title="Book your trip">Book your trip</a>
    </div>
  </section>

  <section class="sec__vacation" id="parallax_home">
    <div class="container">
      <br />
      <h2 class="heading_home_best">What are you waiting for?</h2>
      <p class="text--grey text--center">Your next adventure start here, in the heart of Patagonia Argentina</p>
    </div>
  </section>

  <section class="sec__about derivador-home">
    <div class="container">
      <div class="row">
        <div class="col-md-6">
          <div class="derivadores" id="derivador-2">
            <h2 class="heading_home_best">Fishing with <br /> experienced guides</h2>
            <p class="text--best text--center">Live your best fishing experience with professional guides.</p>
            <a class="btn btn--full btn--oval btn_best" href="/programs/" role="button" title="programs">Explore our programs</a>
          </div>
        </div>
        <div class="col-md-6">
          <div class="derivadores" id="derivador-1">
            <h2 class="heading_home_best">Fishing in <br /> the best waters</h2>
            <p class="text--best text--center">Fish in the best environments of North Patagonia region. Nahuel Huapi &amp; Lanin National parks.</p>
            <a class="btn btn--full btn--oval btn_best" href="/destinations/" role="button" title="destinations">Discover our destinations</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="about__insert">
    <div class="container">
      <div class="row padding-top2x padding-bottom2x">
        <h2 class="heading--big text--center">Why choose us?</h2>
        <p class="heading--small text--center">Experience and Adventure</p>
        <div class="col-md-1 text--center"></div>
        <div class="col-md-2 text--center">
          <img src="/images/home/icons/icon_safety_01.png" alt="Safety Icon" />
          <h4 class="about__sub-heading">Safety First</h4>
          <p class="text--grey">The key to enjoying any activity outdoors is to always prioritize safety.</p>
        </div>
        <div class="col-md-2 text--center">
          <img src="/images/home/icons/icon_boat_02.png" alt="Boat Icon" />
          <h4 class="about__sub-heading">Classic wood <br /> drift boat</h4>
          <p class="text--grey">Best quality boats, safety custom design, for comfort and efficiency.</p>
        </div>
        <div class="col-md-2 text--center">
          <img src="/images/home/icons/icon_lunch_03.png" alt="Lunch Icon" />
          <h4 class="about__sub-heading">Full lunch &amp; beverages</h4>
          <p class="text--grey">We provide to our clients the best service during the programs.</p>
        </div>
        <div class="col-md-2 text--center">
          <img src="/images/home/icons/icon_transport_04.png" alt="Transport Icon" />
          <h4 class="about__sub-heading">Transportation</h4>
          <p class="text--grey">From Lodging to a fishing site: Ground transportation from and to the fishing sites, lodging and Bariloche airport.</p>
        </div>
        <div class="col-md-2 text--center">
          <img src="/images/home/icons/icon_gear_05.png" alt="Gear Icon" />
          <h4 class="about__sub-heading">All necesary <br /> fishing gear</h4>
          <p class="text--grey">Best quality fishing gear is provided to our guests, top brands: Redington, TFO, Simms , Sage.</p>
        </div>
        <div class="col-md-1 text--center"></div>
      </div>
    </div>
    <div class="insert__overlay"></div>
  </div>

  <Reviews lang="en" />

  <section class="sec__contact">
    <div class="container">
      <h2 class="heading--big text--center">Contact Us</h2>
      <h3 class="text--grey text--center">FOR A SALUTATION OR FOR INFORMATION!</h3>
      <img class="separador" src="/images/shared/separators/separador.png" alt="separador" />
      <ContactForm lang="en" />
    </div>
  </section>

  <section class="newsletter">
    <div class="container">
      <div class="row">
        <div class="col-md-4">
          <img src="/images/home/newsletter/newsletter_mockup.png" alt="Laptop" class="img-responsive" />
        </div>
        <div class="col-md-4">
          <h2>Join Our Newsletter</h2>
          <p>Receive information about upcoming hosted trips, scouting reports, and the latest destination updates.</p>
        </div>
        <div class="col-md-4">
          <NewsletterForm lang="en" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll('a[href="#intro"]').forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      document.getElementById("intro")?.scrollIntoView({ behavior: "smooth" });
    });
  });
</script>
