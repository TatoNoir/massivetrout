---
import type { Lang } from "../i18n/ui";
import { getUi, bookingCategories, travelSeasons } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);
const categories = bookingCategories[lang];
const activeCategories = categories.filter((c) => c.programs.length > 0);
const seasons = travelSeasons[lang];
const siteBase = import.meta.env.PUBLIC_SITE_BASE ?? "";
const programsJson = JSON.stringify({
  programs: categories.flatMap((cat) =>
    cat.programs.map((p) => ({
      ...p,
      img: siteBase + p.img,
      categoryId: cat.id,
      category: cat.title,
    }))
  ),
});
---

<script type="application/json" data-programs set:html={programsJson}></script>

<section class="sec__booking" id="booking">
  <div class="container">
    <div class="booking-step" data-step="1" data-step-panel>
      <div class="booking-banner">
        <h2 class="heading--small booking-step-title">{t["booking.step1Title"]}</h2>

        <div class="row booking-category-nav">
          {activeCategories.map((cat) => (
            <div class="col-md-4">
              <a
                class="btn btn--oval btn--booking-category"
                href={`#booking-cat-${cat.id}`}
              >
                {cat.title}
              </a>
            </div>
          ))}
        </div>
      </div>

      {activeCategories.map((cat) => (
        <div class="booking-category" data-category={cat.id} id={`booking-cat-${cat.id}`}>
          <div class="row booking-category__header">
            <div class="col-md-12">
              <h2 class="booking-category__title">{cat.title}</h2>
            </div>         
          </div>

          <div class="row">
            {cat.programs.map((p) => (
              <div class="col-md-4">
                <div class="card-programs">
                  <img src={p.img} alt={p.title} class="img-responsive" loading="lazy" />
                  <h2 class="home-programs-title programs-title">{p.title}</h2>
                  <button
                    type="button"
                    class="btn btn--oval btn--booking-select"
                    data-program-select
                    data-program-id={p.id}
                  >
                    {t["booking.select"]}
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="booking-step" data-step="2" data-step-panel hidden>
      <div class="row">
        <div class="col-md-5">
          <div class="card--info">
            <img src="" alt="" class="img-responsive booking-program-img" data-program-img />
            <h4 class="booking-category-label" data-program-category></h4>
            <h2 class="heading--small" data-program-title></h2>
            <p class="text--grey" data-program-detail></p>
          </div>
        </div>

        <div class="col-md-7">
          <div class="card--info">
            <h2 class="heading--small">{t["booking.yourData"]}</h2>
            <form
              id="booking-form"
              class="contact-form"
              role="form"
              novalidate
              data-sent-msg={t["booking.sent"]}
              data-error-msg={t["booking.error"]}
            >
              <input type="hidden" name="program_id" data-program-id-input />
              <input type="hidden" name="program" data-program-title-input />
              <input type="hidden" name="category" data-category-input />

              <div class="row">
                <div class="col-md-6">
                  <label for="bookingNameInput">{t["booking.fullName"]}</label>
                  <input
                    type="text"
                    placeholder="Thomas Fuks"
                    name="name"
                    id="bookingNameInput"
                    required
                  />
                </div>
                <div class="col-md-6">
                  <label for="bookingEmailInput">{t["booking.email"]}</label>
                  <input
                    type="email"
                    placeholder="thomas@mailbox.com"
                    name="email"
                    id="bookingEmailInput"
                    required
                  />
                </div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <label for="bookingPhoneInput">{t["booking.phone"]}</label>
                  <input
                    type="tel"
                    placeholder="999 222 111"
                    name="phone"
                    id="bookingPhoneInput"
                    pattern="[0-9+() -]{7,20}"
                  />
                </div>
                <div class="col-md-6">
                  <label for="bookingPassengersInput">{t["booking.passengers"]}</label>
                  <input
                    type="number"
                    name="passengers"
                    id="bookingPassengersInput"
                    min="1"
                    max="8"
                    value="1"
                    required
                  />
                </div>
              </div>

              <div class="row">
                <div class="col-md-12">
                  <label for="bookingSeasonInput">{t["booking.season"]}</label>
                  <small class="booking-dates-hint">{t["booking.datesHint"]}</small>
                  <select id="bookingSeasonInput" name="season" required>
                    {seasons.map((s) => (
                      <option value={s}>{s}</option>
                    ))}
                  </select>
                  
                </div>
              </div>

              <div class="row">
                <div class="col-md-12">
                  <label for="bookingDatesInput">{t["booking.dates"]}</label>
                  <input
                    type="text"
                    name="dates"
                    id="bookingDatesInput"
                    placeholder="Nov 20 - Dec 02, 2026"
                    data-lang={lang}
                  />
                  <input
                    type="text"
                    name="company_website"
                    class="hp-field"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                  />
                </div>
              </div>

              <div class="booking-form-actions">
                <input
                  class="btn btn--oval btn--booking-submit"
                  type="submit"
                  value={t["booking.send"]}
                />
                <button
                  type="button"
                  class="btn btn--oval btn--booking-back"
                  data-program-back
                >
                  &larr; {t["booking.back"]}
                </button>
              </div>
              <h6 class="contact-alert" role="status"></h6>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hp-field {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .booking-step[hidden] {
    display: none;
  }

  .booking-step {
    margin-bottom: 1rem;
  }

  .btn--booking-select {
    margin-top: 0.75rem;
    width: 100%;
    cursor: pointer;
    background: #db5328;
    border: 2px solid #db5328;
    border-radius: 2.1875rem;
    color: #fff;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .btn--booking-select:hover {
    background: #545454;
    border-color: #545454;
    color: #fff;
  }

  .btn--booking-back {
    margin-bottom: 1.5rem;
    cursor: pointer;
    background: transparent;
    border: 2px solid #db5328;
    border-radius: 2.1875rem;
    color: #db5328;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .btn--booking-back:hover {
    background: #db5328;
    color: #fff;
  }

  .booking-form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 16rem;
  }

  .booking-form-actions .btn--booking-submit,
  .booking-form-actions .btn--booking-back {
    margin: 0;
    width: 100%;
    max-width: none;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .btn--booking-submit {
    background: #db5328;
    border: 2px solid #db5328;
    color: #fff;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .btn--booking-submit:hover {
    background: #545454;
    border-color: #545454;
    color: #fff;
  }

  .card--info {
    text-align: center;
  }

  .card-programs {
    text-align: center;
    border: 0.2px solid #d7d7d7;
    border-radius: 25px;
  }

  .booking-step-title {
    text-align: center;
    font-size: 1.8rem;
  }

  .booking-category {
    margin-bottom: 2.5rem;
    scroll-margin-top: 6rem;
  }

  .booking-category-nav {
    margin-bottom: 1rem;
  }

  .btn--booking-category {
    display: block;
    cursor: pointer;
    text-decoration: none;
    background: #ffffff;
    color: #000000;
    font-weight: bold;
    border: 2px solid #db5328;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    margin-bottom: 5%
  }

  .btn--booking-category:hover {
    
    color: #db5328;
    border-color: #939393;
  }

  .booking-category__header {
    align-items: center;
    margin-bottom: 1.5rem;
    margin-top: 2.5rem;
  }

  .booking-category__img {
    border-radius: 50%;
    width: 50%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .booking-category__title {
    font-size: 1.7rem;
    margin-top: 0;
    background: #dcdcdc;
    padding: 2%;
    text-align: center;
  }

  .booking-category-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #db5328;
    margin-bottom: 0.25rem;
  }

  .booking-step[data-step="1"] .card-programs img {
    width: 100%;
    aspect-ratio: 425 / 522;
    object-fit: cover;
    border-radius: 15px
  }

  .booking-step[data-step="1"] .card-programs h2 {
    font-size: 1.15rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .booking-step[data-step="2"] .card--info {
    text-align: left;
  }

  .booking-step[data-step="2"] .card--info h2 {
    font-size: 1.3rem;
  }

  .booking-step[data-step="2"] .card--info p {
    font-size: 1.1rem;
  }

  .booking-program-img {
    width: 100%;
  }
</style>

<script>
  const stepPanels = Array.from(document.querySelectorAll("[data-step-panel]"));
  const selectButtons = Array.from(document.querySelectorAll("[data-program-select]"));
  const backButton = document.querySelector("[data-program-back]");

  const step1 = document.querySelector('[data-step-panel][data-step="1"]');
  const step2 = document.querySelector('[data-step-panel][data-step="2"]');

  const hiddenIdInput = document.querySelector("[data-program-id-input]");
  const hiddenTitleInput = document.querySelector("[data-program-title-input]");
  const hiddenCategoryInput = document.querySelector("[data-category-input]");
  const detailImg = document.querySelector("[data-program-img]");
  const detailCategory = document.querySelector("[data-program-category]");
  const detailTitle = document.querySelector("[data-program-title]");
  const detailText = document.querySelector("[data-program-detail]");

  function showStep(n: number) {
    stepPanels.forEach((panel) => {
      const el = panel as HTMLElement;
      const step = Number(el.dataset.step);
      if (step === n) {
        el.hidden = false;
      } else {
        el.hidden = true;
      }
    });
  }

  selectButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const programId = (btn as HTMLElement).dataset.programId;
      const programs: Array<{
        id: string;
        title: string;
        img: string;
        detail: string;
        category: string;
      }> = JSON.parse(
        document.querySelector("[data-programs]")?.textContent ?? "{}"
      ).programs;
      const program = programs.find((p) => p.id === programId);
      if (!program) return;

      hiddenIdInput?.setAttribute("value", program.id);
      hiddenTitleInput?.setAttribute("value", program.title);
      hiddenCategoryInput?.setAttribute("value", program.category);
      detailImg?.setAttribute("src", program.img);
      detailImg?.setAttribute("alt", program.title);
      detailCategory!.textContent = program.category;
      detailTitle!.textContent = program.title;
      detailText!.textContent = program.detail;

      showStep(2);
    });
  });

  backButton?.addEventListener("click", () => {
    showStep(1);
  });

  const form = document.getElementById("booking-form") as HTMLFormElement;
  const alertEl = form?.querySelector(".contact-alert") as HTMLElement | null;
  const endpoint: string | undefined =
    import.meta.env.PUBLIC_BOOKING_ENDPOINT as string | undefined;

  const datesInput = document.getElementById(
    "bookingDatesInput"
  ) as HTMLInputElement | null;
  if (datesInput && typeof window.flatpickr === "function") {
    const esLocale = (window as any).flatpickr?.l10ns?.es;

    const today = new Date();
    const now = new Date(
      today.getFullYear(),
      today.getMonth(),
      today.getDate()
    );
    const inSeason = now.getMonth() < 5 || now.getMonth() > 9;
    const firstAvailable = inSeason ? now : new Date(now.getFullYear(), 10, 1);

    window.flatpickr(datesInput, {
      mode: "range",
      dateFormat: "M j, Y",
      minDate: firstAvailable,
      defaultDate: firstAvailable,
      disable: [(d: Date) => {
        const m = d.getMonth();
        return m >= 5 && m <= 9;
      }],
      locale: datesInput.dataset.lang === "es" ? esLocale : undefined,
    });
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const honeypot = form.querySelector(
      '[name="company_website"]'
    ) as HTMLInputElement;
    if (honeypot?.value) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const payload: Record<string, string> = {};
    new FormData(form).forEach((value, key) => {
      payload[key] = String(value);
    });

    const showAlert = (message: string, isError: boolean) => {
      alertEl!.classList.remove("contact-alert__success", "contact-alert__error");
      alertEl!.classList.add(isError ? "contact-alert__error" : "contact-alert__success");
      alertEl!.textContent = message;
      alertEl!.style.display = "block";
    };

    alertEl!.textContent = "…";
    alertEl!.classList.remove("contact-alert__success", "contact-alert__error");
    alertEl!.style.display = "block";

    if (!endpoint) {
      form.reset();
      showAlert(form.dataset.sentMsg ?? "", false);
      return;
    }

    try {
      const res = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        form.reset();
        showAlert(form.dataset.sentMsg ?? "", false);
      } else {
        const text = await res.text();
        showAlert(text, true);
      }
    } catch {
      showAlert(form.dataset.errorMsg ?? "", true);
    }
  });
</script>
