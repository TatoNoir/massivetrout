---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const reviews = [
  {
    name: "Mark Johnson",
    textEn: "If you want to experience world class fly fishing and learn the best tactics to be successful then look no further and reach out to Massive Trout Fly Fishing.com.! Your host and personal guide Julian Cabral will not disappoint. After 6 days of fabulous fly fishing in a variety of environments I cant wait to get back and do it again.",
    textEs: "Si querés vivir la pesca con mosca de clase mundial y aprender las mejores tácticas para tener éxito, no busques más y contactá a Massive Trout Fly Fishing.com. ! Tu anfitrión y guía personal Julian Cabral no te va a decepcionar. Después de 6 días de pesca fabulosa en una variedad de ambientes, no puedo esperar a volver y hacerlo de nuevo.",
  },
  {
    name: "Gustavo C (ARG)",
    textEn: "Es de los mejores guías de pesca de zona, conoce muy bien los lugares y en todo momento hace sentir a la persona como en su casa. Siempre prima la prudencia y la seguridad del cliente. Es de esas excursiones que si uno no tiene una pesca muy fructífera, siente que valió la pena cada momento.",
    textEs: "Es de los mejores guías de pesca de zona, conoce muy bien los lugares y en todo momento hace sentir a la persona como en su casa. Siempre prima la prudencia y la seguridad del cliente. Es de esas excursiones que si uno no tiene una pesca muy fructífera, siente que valió la pena cada momento.",
  },
  {
    name: "Michael B",
    textEn: "Julián is a fantastic guide, his knowledge of the rivers and fly fishing techniques is outstanding. He put us on fish every day and made the trip truly unforgettable. Highly recommended!",
    textEs: "Julián es un guía fantástico, su conocimiento de los ríos y técnicas de pesca con mosca es excepcional. Nos puso peces cada día y hizo que el viaje fuera verdaderamente inolvidable. ¡Muy recomendable!",
  },
];
---

<section class="reviews-section" id="reviews">
  <div class="container">
    <h2 class="heading--big text--center">{t["reviews.title"]}</h2>
    <img class="separador img-responsive" src="/imagenes/body/separador.png" alt="separador" />

    <div class="row reviews-grid">
      <!-- Left column: Video + Photo -->
      <div class="col-md-5">
        <div class="reviews-media">
          <div class="reviews-video">
            <div class="video-wrapper">
              <!-- TODO: Replace with actual video embed URL -->
              <iframe
                src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                title="Massive Trout Fly Fishing"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
          <div class="reviews-photo">
            <!-- TODO: Replace with actual photo path -->
            <img
              src="/images/01_home/brands/logo_orvis.jpg"
              alt="Massive Trout Fly Fishing experience"
              class="img-responsive"
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Right column: TripAdvisor + Reviews -->
      <div class="col-md-7">
        <div class="reviews-right">
          <!-- TripAdvisor Rating Widget -->
          <div class="reviews-tripadvisor-wrapper">
            <div class="reviews-tripadvisor-widget">
              <div id="TA_cdsratingsonlynarrow" class="TA_cdsratingsonlynarrow">
                <ul id="TA_linksdss" class="TA_links mE4BAE">
                  <li id="2jBbNI" class="aWtKBjB9S">
                    <a href="https://www.tripadvisor.com/" target="_blank" rel="nofollow noopener noreferrer">
                      <img src="https://www.tripadvisor.com/img/cdsi/img2/branding/v2/Tripadvisor_lockup_horizontal_secondary_registered-18034-2.svg" alt="TripAdvisor" />
                    </a>
                  </li>
                </ul>
              </div>
              <script
                is:inline
                async
                src="https://www.jscache.com/wejs?wtype=cdsratingsonlynarrow&amp;uniq=18034&amp;locationId=15098716&amp;lang=en_US&amp;border=true&amp;display_version=2"
                data-loadtrk
                onload="this.loadtrk=true"
              ></script>
            </div>
          </div>

          <!-- Reviews list -->
          <div class="reviews-list">
            {
              reviews.map((review) => (
                <div class="review-card">
                  <div class="review-stars">★★★★★</div>
                  <p class="review-text">
                    <span class="review-quote">&ldquo;</span>
                    {lang === "es" ? review.textEs : review.textEn}
                    <span class="review-quote">&rdquo;</span>
                  </p>
                  <p class="review-author">— {review.name}</p>
                </div>
              ))
            }
          </div>

          <!-- TripAdvisor link -->
          <div class="reviews-tripadvisor-link">
            <a
              href="https://www.tripadvisor.com.ar/Attraction_Review-g312848-d15098716-Reviews-Massive_Trout_Fly_Fishing-San_Carlos_de_Bariloche_Province_of_Rio_Negro_Patagoni.html"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="btn btn-primary"
            >
              {t["reviews.readMore"]} <i class="fa fa-long-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .reviews-grid {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 2rem;
  }

  .reviews-media {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .reviews-photo img {
    width: 100%;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .reviews-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .reviews-tripadvisor-wrapper {
    max-width: 100%;
    overflow: hidden;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .reviews-tripadvisor-widget {
    display: flex;
    justify-content: center;
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .review-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    border-left: 4px solid #db5328;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .review-stars {
    color: #f5a623;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    letter-spacing: 2px;
  }

  .review-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0 0 0.75rem 0;
    font-style: italic;
  }

  .review-quote {
    color: #db5328;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 0;
    vertical-align: -0.2em;
  }

  .review-author {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
    margin: 0;
  }

  .reviews-tripadvisor-link {
    text-align: center;
    padding-top: 0.5rem;
  }

  .reviews-tripadvisor-link .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #db5328;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .reviews-tripadvisor-link .btn:hover {
    background: #c4471e;
    transform: translateY(-1px);
  }

  .reviews-tripadvisor-link .btn i {
    margin-left: 0.5rem;
  }

  /* Mobile */
  @media (max-width: 991px) {
    .reviews-grid {
      flex-direction: column;
    }

    .reviews-media {
      order: 2;
    }

    .reviews-right {
      order: 1;
    }
  }

  @media (max-width: 767px) {
    .reviews-section {
      padding: 2.5rem 0;
    }

    .review-card {
      padding: 1.25rem;
    }
  }
</style>
