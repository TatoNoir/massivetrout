---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const reviews = [
  {
    name: "Paul C",
    textEn: "I spent 5 days fishing with MTFF. I have fished with many excellent guides in the U.S. and abroad. MTFF is among the best. Julian is a true angler's guide. Where other guides might be content to fish the same way all day, and certainly catch fish, Julian goes the extra mile (literally) ferrying back forth across the river to find the best lies, rowing upstream to re-float a promising run or whatever else it takes to maximize the experience. In a relaxed way he keeps you engaged while constantly scanning, adjusting and coaching you to the best of your abilities. The streamside lunches were very nice and relaxed and Julian just a wonderful person to be with for a day (or more) on a river. I caught many fish learned a lot with him. I can't wait to go back.",
    textEs: "Si querés vivir la pesca con mosca de clase mundial y aprender las mejores tácticas para tener éxito, no busques más y contactá a Massive Trout Fly Fishing.com. ! Tu anfitrión y guía personal Julian Cabral no te va a decepcionar. Después de 6 días de pesca fabulosa en una variedad de ambientes, no puedo esperar a volver y hacerlo de nuevo.",
  },
  {
    name: "Aidan C (ARG)",
    textEn: "Massive Trout has some of the best guides in the region! Super knowledgeable and great customer service! Highly recommend them!",
    textEs: "Massive Trout tiene algunos de los mejores guías de la región! Muy conocedores y excelente atención al cliente! Los recomiendo ampliamente!",
  },
  {
    name: "Ron K",
    textEn: "The team at Massive Trout provided a seamless experience from the day we arrived, friendly and attentive staff, awesome meals, great tips in fly fishing techniques and patience with the lesser experienced. Particularly enjoyed the overnight float, camping, as much fishing as you want and enjoying the Patagonian wilderness and wildlife.",
    textEs: "El equipo de Massive Trout nos brindó una experiencia impecable desde el día que llegamos. Personal amable y atento, comidas excelentes, grandes consejos en técnicas de pesca con mosca y paciencia con los menos experimentados. Disutamos especialmente del flotado nocturno, el camping, tanta pesca como quisieras y disfrutar de la naturaleza y fauna de la Patagonia.",
  },
];
---

<section class="reviews-section" id="reviews">
  <div class="container">
    <h2 class="heading--big text--center reviews-main-title">{t["reviews.title"]}</h2>

    <!-- Row 1: Video + Photo -->
    <div class="row reviews-media-row">
      
      <div class="col-md-6">
        <div class="reviews-media-col">
          <div class="reviews-photo">
            <img
              src="/images/home/reviews/home_reviews.jpeg"
              alt="Massive Trout Fly Fishing experience"
              class=""
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="reviews-media-col">
          
          <div class="reviews-video-card">
            <div class="reviews-video">
              <div class="video-wrapper">
                <iframe
                  src="https://www.youtube.com/embed/qCguxARxt8Y?controls=0&rel=0&modestbranding=1&loop=1&playlist=qCguxARxt8Y"
                  title="Massive Trout Fly Fishing"
                  frameborder="0"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <h3 class="reviews-video-title" set:html={t["reviews.videoTitle"]} />
            </div>
            
          </div>
        </div>
      </div>

    </div>



    <!-- Row 2: TripAdvisor Rating -->
    <div class="reviews-tripadvisor-wrapper">
      <a
        href="https://www.tripadvisor.com.ar/Attraction_Review-g312848-d15098716-Reviews-Massive_Trout_Fly_Fishing-San_Carlos_de_Bariloche_Province_of_Rio_Negro_Patagoni.html"
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="reviews-tripadvisor-link-wrapper"
      >
        <div class="reviews-tripadvisor-static">
          <img src="https://www.tripadvisor.com/img/cdsi/img2/branding/v2/Tripadvisor_lockup_horizontal_secondary_registered-18034-2.svg" alt="TripAdvisor" class="tripadvisor-logo" />
          <div class="tripadvisor-rating">
            <span class="tripadvisor-stars">★★★★★</span>
            <span class="tripadvisor-count">43 reviews</span>
          </div>
        </div>
      </a>
       <!-- TripAdvisor link -->
      
        <a
          href="https://www.tripadvisor.com.ar/Attraction_Review-g312848-d15098716-Reviews-Massive_Trout_Fly_Fishing-San_Carlos_de_Bariloche_Province_of_Rio_Negro_Patagoni.html"
          target="_blank"
          rel="nofollow noopener noreferrer"
          class=" btn-primary"
        >
          {t["reviews.readMore"]} <i class="fa fa-long-arrow-right"></i>
        </a>
      
    </div>

    <!-- Row 3: Reviews -->
    <div class="row reviews-list">
      <div class="col-md-6">
        <div class="review-card review-card--featured">
          <div class="review-stars">★★★★★</div>
          <p class="review-text">
            <span class="review-quote">&ldquo;</span>
            {lang === "es" ? reviews[0].textEs : reviews[0].textEn}
            <span class="review-quote">&rdquo;</span>
          </p>
          <p class="review-author">— {reviews[0].name}</p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="reviews-column">
          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">
              <span class="review-quote">&ldquo;</span>
              {lang === "es" ? reviews[1].textEs : reviews[1].textEn}
              <span class="review-quote">&rdquo;</span>
            </p>
            <p class="review-author">— {reviews[1].name}</p>
          </div>
          <div class="review-card">
            <div class="review-stars">★★★★★</div>
            <p class="review-text">
              <span class="review-quote">&ldquo;</span>
              {lang === "es" ? reviews[2].textEs : reviews[2].textEn}
              <span class="review-quote">&rdquo;</span>
            </p>
            <p class="review-author">— {reviews[2].name}</p>
          </div>
        </div>
      </div>
    </div>

   

    <!-- Book your trip CTA -->
    <div class="reviews-book-cta">
      <a href="/booking/" class="btn btn--full btn--oval">
        {t["reviews.bookCta"]}
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 4rem 0;
    background: #f9f9f9 url(/images/shared/separators/fondo_topo.svg);
  }

  .reviews-section .reviews-grid.container,
  .reviews-section .container {
    max-width: 1400px !important;
    width: 1400px !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .reviews-main-title {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    border-bottom: 3px solid #DB5328;
    padding-bottom: 0.5rem;
    display: block;
    text-align: center;
  }

  /* Row 1: Video + Photo */
  .reviews-media-row {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
    align-items: stretch;
  }

  .reviews-media-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .reviews-video-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }

  .reviews-video-card {
    width: 100%;
    max-width: 520px;
    padding: 1.5rem;
    
  }

  .reviews-video {
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 133%;
    height: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .reviews-photo {
    padding-top: 1.5rem;
  }

  .reviews-photo img {
    width: 120%;
    object-fit: cover;
    border-radius: 15px;
  }

  /* Row 2: TripAdvisor */
  .reviews-tripadvisor-wrapper {
        max-width: 100%;
    overflow: hidden;
    padding: 1rem 1rem;
    margin-bottom: 2rem;
    display: flex;
    justify-content: space-around;
    align-items: center;
  }

  .reviews-tripadvisor-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .reviews-tripadvisor-static {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: space-around;
    padding: 0 5rem;
  }

  .tripadvisor-logo {
    height: 50px;
    width: auto;
  }

  .tripadvisor-rating {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .tripadvisor-stars {
    color: #00aa6c;
    font-size: 1.2rem;
    letter-spacing: 2px;
  }

  .tripadvisor-count {
    font-size: 0.8rem;
    color: #666;
  }

  .reviews-tripadvisor-widget {
    display: flex;
    justify-content: center;
  }

  .reviews-list {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .reviews-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .review-card--featured {
    height: 100%;
  }

  .review-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    border-left: 4px solid #db5328;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .review-stars {
    color: #f5a623;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    letter-spacing: 2px;
  }

  .review-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0 0 0.75rem 0;
    font-style: italic;
  }

  .review-quote {
    color: #db5328;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 0;
    vertical-align: -0.2em;
  }

  .review-author {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
    margin: 0;
  }

  .reviews-tripadvisor-link {
    text-align: center;
    padding-top: 0.5rem;
    margin-top: 1rem;
  }

  .reviews-tripadvisor-link .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #db5328;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .reviews-tripadvisor-link .btn:hover {
    background: #c4471e;
    transform: translateY(-1px);
  }

  .reviews-tripadvisor-link .btn i {
    margin-left: 0.5rem;
  }

  .reviews-book-cta {
    text-align: center;
    padding-top: 0.5rem;
    margin-top: 1.5rem;
  }

  /* Mobile */
  @media (max-width: 991px) {
    .reviews-section .container {
      max-width: 100% !important;
      width: auto !important;
      padding-left: 15px !important;
      padding-right: 15px !important;
    }

    .reviews-media-row {
      flex-direction: column;
      gap: 1.5rem;
    }

    .reviews-media-col {
      padding-top: 0;
    }

    .reviews-video-card {
      max-width: 100%;
    }

    .reviews-photo {
      max-width: 100%;
    }

    .reviews-tripadvisor-static {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 767px) {
    .reviews-section {
      padding: 2.5rem 0;
    }

    .reviews-video-title {
      font-size: 1rem;
    }

    .review-card {
      padding: 1.25rem;
    }

    .review-text {
      font-size: 0.9rem;
    }

    .reviews-tripadvisor-link .btn {
      padding: 0.6rem 1.5rem;
      font-size: 0.9rem;
    }
  }
</style>
