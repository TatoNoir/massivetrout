---
import { ui, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const reviews = [
  {
    name: "Paul C",
    textEn: "I spent 5 days fishing with MTFF. I have fished with many excellent guides in the U.S. and abroad. MTFF is among the best. Julian is a true angler's guide. Where other guides might be content to fish the same way all day, and certainly catch fish, Julian goes the extra mile (literally) ferrying back forth across the river to find the best lies, rowing upstream to re-float a promising run or whatever else it takes to maximize the experience. In a relaxed way he keeps you engaged while constantly scanning, adjusting and coaching you to the best of your abilities. The streamside lunches were very nice and relaxed and Julian just a wonderful person to be with for a day (or more) on a river. I caught many fish learned a lot with him. I can't wait to go back.",
    textEs: "Si querés vivir la pesca con mosca de clase mundial y aprender las mejores tácticas para tener éxito, no busques más y contactá a Massive Trout Fly Fishing.com. ! Tu anfitrión y guía personal Julian Cabral no te va a decepcionar. Después de 6 días de pesca fabulosa en una variedad de ambientes, no puedo esperar a volver y hacerlo de nuevo.",
  },
  {
    name: "Aidan C (ARG)",
    textEn: "Massive Trout has some of the best guides in the region! Super knowledgeable and great customer service! Highly recommend them!",
    textEs: "Massive Trout tiene algunos de los mejores guías de la región! Muy conocedores y excelente atención al cliente! Los recomiendo ampliamente!",
  },
  {
    name: "Ron K",
    textEn: "The team at Massive Trout provided a seamless experience from the day we arrived, friendly and attentive staff, awesome meals, great tips in fly fishing techniques and patience with the lesser experienced. Particularly enjoyed the overnight float, camping, as much fishing as you want and enjoying the Patagonian wilderness and wildlife.",
    textEs: "El equipo de Massive Trout nos brindó una experiencia impecable desde el día que llegamos. Personal amable y atento, comidas excelentes, grandes consejos en técnicas de pesca con mosca y paciencia con los menos experimentados. Disutamos especialmente del flotado nocturno, el camping, tanta pesca como quisieras y disfrutar de la naturaleza y fauna de la Patagonia.",
  },
];
---

<section class="reviews-section" id="reviews">
  <div class="container">
    <h2 class="heading--big text--center">{t["reviews.title"]}</h2>
    
    <div class="row reviews-grid">
      <!-- Left column: Video + Photo -->
      <div class="col-md-5">
        <div class="reviews-media">
          <h3 class="reviews-video-title" set:html={t["reviews.videoTitle"]} />
          <div class="reviews-video">
            <div class="video-wrapper">
              <!-- TODO: Replace with actual video embed URL -->
              <iframe
                src="https://www.youtube.com/embed/dQw4w9WgXcQ"
                title="Massive Trout Fly Fishing"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column: TripAdvisor + Reviews -->
      <div class="col-md-7">
        <div class="reviews-right">
          <!-- TripAdvisor Rating Widget -->
          <div class="reviews-tripadvisor-wrapper">
            <div class="reviews-tripadvisor-widget">
              <div id="TA_cdsratingsonlynarrow" class="TA_cdsratingsonlynarrow">
                <ul id="TA_linksdss" class="TA_links mE4BAE">
                  <li id="2jBbNI" class="aWtKBjB9S">
                    <a href="https://www.tripadvisor.com/" target="_blank" rel="nofollow noopener noreferrer">
                      <img src="https://www.tripadvisor.com/img/cdsi/img2/branding/v2/Tripadvisor_lockup_horizontal_secondary_registered-18034-2.svg" alt="TripAdvisor" />
                    </a>
                  </li>
                </ul>
              </div>
              <script
                is:inline
                async
                src="https://www.jscache.com/wejs?wtype=cdsratingsonlynarrow&amp;uniq=18034&amp;locationId=15098716&amp;lang=en_US&amp;border=true&amp;display_version=2"
                data-loadtrk
                onload="this.loadtrk=true"
              ></script>
            </div>
          </div>

          <!-- Reviews list -->
          <div class="reviews-list">
            {
              reviews.map((review) => (
                <div class="review-card">
                  <div class="review-stars">★★★★★</div>
                  <p class="review-text">
                    <span class="review-quote">&ldquo;</span>
                    {lang === "es" ? review.textEs : review.textEn}
                    <span class="review-quote">&rdquo;</span>
                  </p>
                  <p class="review-author">— {review.name}</p>
                </div>
              ))
            }
          </div>

          <!-- TripAdvisor link -->
          <div class="reviews-tripadvisor-link">
            <a
              href="https://www.tripadvisor.com.ar/Attraction_Review-g312848-d15098716-Reviews-Massive_Trout_Fly_Fishing-San_Carlos_de_Bariloche_Province_of_Rio_Negro_Patagoni.html"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="btn btn-primary"
            >
              {t["reviews.readMore"]} <i class="fa fa-long-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 4rem 0;
    background: #f9f9f9;
  }

  .reviews-grid {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-top: 2rem;
  }

  .reviews-media {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
  }

  @media (max-width: 991px) {
    .reviews-media {
      padding-top: 0;
    }
  }

  .reviews-video-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
    text-align: center;
    margin: 0;
    line-height: 1.3;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 133%; /* 3:4 vertical */
    height: 0;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .reviews-right {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .reviews-tripadvisor-wrapper {
    max-width: 100%;
    overflow: hidden;
    margin: 0 auto;
    padding: 1rem 0;
  }

  .reviews-tripadvisor-widget {
    display: flex;
    justify-content: center;
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .review-card {
    background: #fff;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    border-left: 4px solid #db5328;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .review-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .review-stars {
    color: #f5a623;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    letter-spacing: 2px;
  }

  .review-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #555;
    margin: 0 0 0.75rem 0;
    font-style: italic;
  }

  .review-quote {
    color: #db5328;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 0;
    vertical-align: -0.2em;
  }

  .review-author {
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
    margin: 0;
  }

  .reviews-tripadvisor-link {
    text-align: center;
    padding-top: 0.5rem;
  }

  .reviews-tripadvisor-link .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    background: #db5328;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .reviews-tripadvisor-link .btn:hover {
    background: #c4471e;
    transform: translateY(-1px);
  }

  .reviews-tripadvisor-link .btn i {
    margin-left: 0.5rem;
  }

  /* Mobile */
  @media (max-width: 991px) {
    .reviews-grid {
      flex-direction: column;
    }

    .reviews-media {
      order: 2;
    }

    .reviews-right {
      order: 1;
    }
  }

  @media (max-width: 767px) {
    .reviews-section {
      padding: 2.5rem 0;
    }

    .review-card {
      padding: 1.25rem;
    }
  }
</style>
