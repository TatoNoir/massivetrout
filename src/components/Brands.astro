---
interface Props {
  heading: string;
  subheading: string;
  className?: string;
}
const { heading, subheading, className = "" } = Astro.props;

const brands = [
  "logo_orvis.jpg",
  "logo_scientific_anglers.jpg",
  "logo_rio_products.jpg",
  "logo_redington.jpg",
  "logo_simms.jpg",
  "logo_nrs.jpg",
  "logo_tfo.jpg",
  "logo_coleman.jpg",
  "logo_eureka.jpg",
  "logo_iridium.jpg",
  "logo_botes_del_limay.jpg",
];
---

<section class={`brands ${className}`}>
  <h2 class="heading--big text--center">{heading}</h2>
  <h3 class="heading--small text--center">{subheading}</h3>
  <img class="separador img-responsive" src="/imagenes/body/separador.png" alt="separador" />

  <div class="row">
    <div class="col-12">
      {
        brands.slice(0, 6).map((b) => (
          <img src={`/images/01_home/brands/${b}`} alt="" class="img-responsive brand-logo" loading="lazy" />
        ))
      }
    </div>
  </div>
  <div class="row">
    <div class="col-12">
      {
        brands.slice(6).map((b) => (
          <img src={`/images/01_home/brands/${b}`} alt="" class="img-responsive brand-logo" loading="lazy" />
        ))
      }
    </div>
  </div>
</section>
