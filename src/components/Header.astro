---
import type { Lang } from "../i18n/ui";
import { siteConfig, getUi } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getUi(lang);

const pathname = Astro.url.pathname;
const isEs = pathname.startsWith("/es");
const path = isEs ? pathname.replace(/^\/es/, "") : pathname;
const otherLang: Lang = isEs ? "en" : "es";
const langSwitchHref =
  otherLang === "es" ? `/es${path === "/" ? "" : path}` : path || "/";

const prefix = isEs ? "/es" : "";
const navItems = [
  { href: `${prefix}/programs/`, label: t["nav.programs"], dropdown: [
    { href: `${prefix}/programs/#argentina`, label: t["nav.programs.argentina"] },
    { href: `${prefix}/programs/usa/`, label: t["nav.programs.usa"] },
  ]},
  { href: `${prefix}/destinations/`, label: t["nav.destinations"], dropdown: [
    { href: `${prefix}/destinations/#patagonia`, label: t["nav.destinations.patagonia"] },
    { href: `${prefix}/destinations/dorado/`, label: t["nav.destinations.corrientes"] },
    { href: `${prefix}/destinations/usa/`, label: t["nav.destinations.wyoming"] },
  ]},
  { href: `${prefix}/about/`, label: t["nav.story"] },
  { href: `${prefix}/contact/`, label: t["nav.contact"] },
] as const;
---

<header role="banner">
  <div class="container">
    <nav role="navigation">
      <div class="logo-container">
        <a href={isEs ? "/es/" : "/"} aria-label="Massive trout logo">
          <img src="/images/shared/head/logo_color.png" alt="Massive trout logo" />
        </a>
      </div>

      <label class="label__nav_checkbox" for="nav_checkbox">
        <i class="fa fa-bars"></i>
      </label>

      <ul class="up_nav">
        <li class="up_list"><a href={isEs ? "/es/faqs/" : "/faqs/"}>{t["nav.faqs"]}</a></li>
      </ul>

      <input id="nav_checkbox" class="nav_checkbox" type="checkbox" />

      <ul class="nav-list">
        <li class="subnav__parent nav-cta">
          <a class="nav-cta__link" href={`${prefix}/booking/`}>
            {t["nav.book"]}
          </a>
        </li>

        {navItems.map((item) => (
          <li class={`subnav__parent${item.dropdown ? ' has-dropdown' : ''}`}>
            {item.dropdown ? (
              <>
                <span class="hide-mobile nav-dropdown-trigger">{item.label} <i class="fa fa-caret-down"></i></span>
                <a class="show-mobile" href={item.href}>{item.label}</a>
                <ul class="nav-dropdown hide-mobile">
                  {item.dropdown.map((sub) => (
                    <li><a href={sub.href}>{sub.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <>
                <a class="show-mobile" href={item.href}>{item.label}</a>
                <a class="hide-mobile" href={item.href}>{item.label}</a>
              </>
            )}
          </li>
        ))}        

        <li class="subnav__parent">
          <a class="show-mobile" href={langSwitchHref}>{t["nav.language"]}</a>
          <a class="hide-mobile" href={langSwitchHref}>
            <img
              class="lang"
              src={isEs ? "/images/shared/head/idioma_ingles.svg" : "/images/shared/head/idioma_esp.svg"}
              alt={t["nav.language"]}
            />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav-cta__link {
    display: inline-block;
    background: #b5312a;
    color: #fff !important;
    padding: 0.5rem 1.1rem !important;
    border-radius: 2rem;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    margin-left: 0.5rem;
    transition: background 0.2s ease;
    margin-top: 12%;
  }

  .nav-cta__link:hover {
    background: #8f241e;
  }

  /* Dropdown */
  .has-dropdown {
    position: relative;
  }

  .nav-dropdown-trigger {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    color: #fff;
  }

  .nav-dropdown-trigger .fa-caret-down {
    font-size: 0.7em;
    transition: transform 0.2s ease;
  }

  .has-dropdown:hover .fa-caret-down {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    list-style: none;
    padding: 0.5rem 0;
    margin: 0;
    min-width: 140px;
    z-index: 1000;
  }

  .has-dropdown:hover .nav-dropdown {
    display: block;
  }

  .nav-dropdown li a {
    display: block;
    padding: 0.5rem 1.2rem;
    color: #333;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .nav-dropdown li a:hover {
    background: #f5f5f5;
    color: #b5312a;
  }

  @media (max-width: 47.99em) {
    .nav-cta {
      margin-top: 0.5rem;
    }

    .nav-cta__link {
      margin-left: 0;
    }

    .nav-dropdown-trigger {
      display: none;
    }
  }
</style>
