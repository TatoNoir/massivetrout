# Massive Trout Fly Fishing - configuración de formularios (SMTP Gmail)
# Copiá este archivo a `.env` o configurá las variables en el hosting.
# NUNCA subas el `.env` real con tus credenciales (ya está en .gitignore).

# Base path del sitio en el build de Astro.
#   Vacío (por defecto)       → dist/ lista para hosting en la raíz del dominio
#   /massivetrout             → para GitHub Pages (ver .github/workflows/deploy.yml)
PUBLIC_SITE_BASE=

# Endpoint PHP del formulario de reservas.
#   Configurá solo en el build que vas a subir al hosting con PHP:
#     PUBLIC_BOOKING_ENDPOINT=/api/booking.php npm run build
#   Dejalo vacío en los builds de vista previa (GitHub Pages) → simula envío.
PUBLIC_BOOKING_ENDPOINT=

# Dónde llegan los mensajes de contacto, newsletter y reservas
MTFF_RECIPIENT=mtroutff@gmail.com

# Remitente (cuenta Gmail autenticada en SMTP)
MTFF_FROM=contact.mtrout@gmail.com

# SMTP de Gmail (App Password: Seguridad → Contraseñas de aplicaciones)
MTFF_SMTP_HOST=smtp.gmail.com
MTFF_SMTP_PORT=587
MTFF_SMTP_SECURE=tls
MTFF_SMTP_USER=contact.mtrout@gmail.com
MTFF_SMTP_PASS=TU_APP_PASSWORD