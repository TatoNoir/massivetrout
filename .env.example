# Massive Trout Fly Fishing - configuración de formularios (SMTP Hostinger)
# Copiá este archivo a `.env` o configurá las variables en el hosting.
# NUNCA subas el `.env` real con tus credenciales (ya está en .gitignore).

# Dónde llegan los mensajes del formulario de contacto y del newsletter
MTFF_RECIPIENT=mtroutff@gmail.com

# Remitente (debe existir en tu plan Hostinger)
MTFF_FROM=contact@massivetroutflyfishing.com

# SMTP de Hostinger
MTFF_SMTP_HOST=smtp.hostinger.com
MTFF_SMTP_PORT=465
MTFF_SMTP_SECURE=ssl
MTFF_SMTP_USER=contact@massivetroutflyfishing.com
MTFF_SMTP_PASS=TU_CONTRASENA_AQUI